{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "timeline.schema.json",
  "title": "War Brokers Timeline Data",
  "type": "object",
  "required": ["schemaVersion", "sources", "entries"],
  "properties": {
    "schemaVersion": { "type": "integer" },
    "generatedAt": { "type": "string" },
    "description": { "type": "string" },
    "entryTypes": { "type": "object" },
    "priorityRules": { "type": "object" },
    "metadata": { "type": "object" },
    "sources": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "type", "name"] }
    },
    "contributionGuide": { "type": "object" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "title",
          "description",
          "releaseDate",
          "priority",
          "tags",
          "image",
          "content",
          "sourceRefs"
        ],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["version_update", "event", "community_project"]
          },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "releaseDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "datePrecision": {
            "type": "string",
            "enum": ["day", "month", "year", "unknown"]
          },
          "priority": {
            "type": "string",
            "enum": ["high", "low"]
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "image": {
            "type": "object",
            "required": ["url", "alt", "needsManualImage"],
            "properties": {
              "url": { "type": ["string", "null"] },
              "alt": { "type": "string" },
              "needsManualImage": { "type": "boolean" }
            }
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url", "alt", "needsManualImage"],
              "properties": {
                "url": { "type": "string" },
                "alt": { "type": "string" },
                "needsManualImage": { "type": "boolean" }
              }
            }
          },
          "content": {
            "type": ["array", "string"]
          },
          "contentSummary": { "type": "boolean" },
          "releaseItems": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "name", "date"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["map", "map_update", "weapon", "mode", "vehicle", "platform", "feature"]
                },
                "name": { "type": "string" },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "dateType": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          },
          "links": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sourceRefs": {
            "type": "array",
            "items": { "type": "object" }
          },
          "relatedEntryIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "mergedEventTitles": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
